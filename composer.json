{
    "name": "ernestdefoe/club",
    "description": "Book and watch clubs for Marquee titles: a monthly pick, a reading or watching schedule, spoiler-gated replies per section and a progress bar for every member.",
    "keywords": [
        "flarum",
        "marquee",
        "book club",
        "watch club",
        "spoilers",
        "reading"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "ernestdefoe/marquee": "^1.6"
    },
    "extra": {
        "flarum-extension": {
            "title": "Club",
            "category": "feature",
            "icon": {
                "name": "fas fa-book-open-reader",
                "backgroundColor": "#1f3b2d",
                "color": "#f2e8cf"
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Club\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Club\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    }
}